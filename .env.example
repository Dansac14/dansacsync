# =============================================================================
# Variables de entorno · Synchrony Dansac · worker
# =============================================================================
# Copia este archivo a .env en la raiz del repositorio. El worker lo lee con
# --env-file=../.env. Esta en .gitignore y nunca debe subirse.
#
# El frontend NO usa este archivo: usa web/.env.local (ver web/.env.local.example).
# El webhook tampoco: sus secretos van con `supabase secrets set`.
#
# Aqui solo estan las variables que el codigo lee de verdad. Los tokens de cada
# canal (Meta, TikTok) no van aqui: se guardan por empresa en Supabase Vault y
# el worker los recupera con get_channel_secret.
# =============================================================================

# -----------------------------------------------------------------------------
# Supabase · obligatorias, el worker no arranca sin ellas
# -----------------------------------------------------------------------------
SUPABASE_URL=
# Ignora la RLS por completo. Solo el worker y las Edge Functions la usan.
SUPABASE_SERVICE_ROLE_KEY=

# -----------------------------------------------------------------------------
# Proveedor de IA
# -----------------------------------------------------------------------------
# Sin esta clave el worker arranca igual: guarda los mensajes y escala cada
# conversacion a una persona. El modelo y la temperatura no van aqui, se
# configuran por empresa en company_settings.
OPENAI_API_KEY=

# Solo si usas un proveedor compatible distinto de OpenAI.
# OPENAI_BASE_URL=https://api.openai.com/v1

# -----------------------------------------------------------------------------
# Meta · token de respaldo del SaaS
# -----------------------------------------------------------------------------
# Se usa unicamente cuando una cuenta de canal no tiene su propio token en
# Vault. Si cada empresa trae el suyo, dejalo vacio.
META_SYSTEM_USER_TOKEN=

# -----------------------------------------------------------------------------
# Worker · todas opcionales, estos son los valores por defecto
# -----------------------------------------------------------------------------
# WORKER_ID queda registrado en locked_by: con varias replicas debe ser distinto
# en cada una.
# WORKER_ID=worker-1
# WORKER_POLL_INTERVAL_MS=1000
# WORKER_BATCH_SIZE=10
# WORKER_CONCURRENCY=5
# LOG_LEVEL=info

# URL publica del Inbox, usada en los enlaces de pago que envia el catalogo.
NEXT_PUBLIC_APP_URL=
