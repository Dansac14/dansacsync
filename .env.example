# =============================================================================
# Variables de entorno · Omnichannel Social CRM
# =============================================================================
# Copia este archivo a .env y complétalo con valores reales.
# .env está en .gitignore y nunca debe subirse al repositorio.
# =============================================================================

# -----------------------------------------------------------------------------
# Supabase
# -----------------------------------------------------------------------------
# La URL y la clave publicable son las únicas que pueden llegar al navegador.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Clave de servicio. Ignora la RLS por completo: solo el worker y las Edge
# Functions la usan, jamás el frontend ni el repositorio.
SUPABASE_SERVICE_ROLE_KEY=

# Conexión directa para aplicar migraciones con el CLI de Supabase.
SUPABASE_DB_URL=

# -----------------------------------------------------------------------------
# Meta · WhatsApp Cloud API, Instagram y Messenger
# -----------------------------------------------------------------------------
# Un solo App de Meta atiende a todos los tenants del SaaS. La empresa a la que
# pertenece cada mensaje se resuelve por el phone_number_id o el page_id que
# viene dentro del propio evento, contra la tabla channel_accounts.
META_APP_ID=
META_APP_SECRET=
META_VERIFY_TOKEN=
META_GRAPH_API_VERSION=v21.0

# Token de System User con permisos de mensajería. Los tenants que traigan su
# propio App de Meta guardan su token en Supabase Vault, no aquí.
META_SYSTEM_USER_TOKEN=

# -----------------------------------------------------------------------------
# TikTok Business Messaging
# -----------------------------------------------------------------------------
TIKTOK_APP_ID=
TIKTOK_APP_SECRET=
TIKTOK_ACCESS_TOKEN=

# -----------------------------------------------------------------------------
# Proveedor de IA
# -----------------------------------------------------------------------------
# El modelo y la temperatura no van aquí: se configuran por empresa en la tabla
# company_settings, para poder cambiarlos sin volver a desplegar.
OPENAI_API_KEY=

# -----------------------------------------------------------------------------
# Worker
# -----------------------------------------------------------------------------
# Identificador de la instancia. Queda registrado en locked_by, así que con
# varias réplicas conviene que sea distinto en cada una.
WORKER_ID=worker-1
WORKER_POLL_INTERVAL_MS=1000
WORKER_BATCH_SIZE=10
WORKER_CONCURRENCY=5

# -----------------------------------------------------------------------------
# Frontend
# -----------------------------------------------------------------------------
# URL pública de la tienda, usada en los enlaces de pago que envía el catálogo.
NEXT_PUBLIC_APP_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
