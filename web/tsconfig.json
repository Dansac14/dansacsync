{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [{ "name": "next" }],
    "paths": { "@/*": ["./*"] }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  // tests/ queda fuera del chequeo de Next: esos archivos se ejecutan con
  // node --experimental-strip-types, que EXIGE la extension .ts en los
  // imports, y el compilador de Next la prohibe. Se verifican por separado
  // con su propia ejecucion.
  "exclude": ["node_modules", "tests"]
}
