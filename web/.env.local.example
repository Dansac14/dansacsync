# =============================================================================
# Variables de entorno · Synchrony Dansac · frontend
# =============================================================================
# Copia este archivo a web/.env.local. Es distinto del .env de la raiz: Next.js
# solo lee .env.local dentro de su propio directorio, y solo expone al navegador
# las variables con prefijo NEXT_PUBLIC_.
#
# En Vercel estas mismas tres se cargan en Settings -> Environment Variables.
#
# La SUPABASE_SERVICE_ROLE_KEY no va aqui ni en Vercel. El Inbox trabaja con la
# sesion del operador y toda consulta pasa por la RLS.
# =============================================================================

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# URL desde la que se sirve el Inbox. En local, http://localhost:3000
NEXT_PUBLIC_APP_URL=
