{
  "name": "omnichannel-crm-worker",
  "version": "0.1.0",
  "private": true,
  "description": "Worker que procesa la cola de eventos entrantes y despacha los mensajes salientes",
  "type": "module",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "node --env-file=../.env --watch --experimental-strip-types src/index.ts",
    "start": "node --env-file=../.env --experimental-strip-types src/index.ts",
    "ingest": "node --env-file=../.env --experimental-strip-types src/ai/ingest.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.0"
  },
  "devDependencies": {
    "@types/node": "^22.7.0",
    "typescript": "^5.6.0"
  }
}
